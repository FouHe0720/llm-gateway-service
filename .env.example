# Copy to .env. Default: offline development with explicitly disabled authentication.
GATEWAY_ENVIRONMENT=development
GATEWAY_AUTH_ENABLED=false
GATEWAY_API_KEY=
GATEWAY_MODELS='[{"model":"mock-echo","provider":"mock","upstream_model":"mock-echo","enabled":true}]'
MOCK_CHUNK_DELAY_SECONDS=0.02

# Any enabled non-Mock model REQUIRES gateway authentication, even in development.
# Set GATEWAY_AUTH_ENABLED=true and a random GATEWAY_API_KEY of >=16 characters.
# GATEWAY_ENVIRONMENT=production also requires authentication.
# Select an actual model supported by your provider, never a private URL in committed files.
# GATEWAY_MODELS='[{"model":"online-chat","provider":"openai","upstream_model":"YOUR_MODEL","enabled":true}]'
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=  # Set privately in .env; never commit a real credential.

# Local uses the SAME Chat Completions HTTP adapter, constrained to localhost.
# Install/start your own Ollama/vLLM separately; this project downloads no weights.
# GATEWAY_MODELS='[{"model":"local-chat","provider":"local","upstream_model":"YOUR_LOCAL_MODEL"}]'
LOCAL_BASE_URL=http://127.0.0.1:11434/v1
# LOCAL_API_KEY=

UPSTREAM_CONNECT_TIMEOUT_SECONDS=3
UPSTREAM_READ_TIMEOUT_SECONDS=20
GATEWAY_REQUEST_TIMEOUT_SECONDS=60
UPSTREAM_MAX_RETRIES=2
UPSTREAM_RETRY_BASE_SECONDS=0.2
UPSTREAM_CONCURRENCY=8
UPSTREAM_MAX_RESPONSE_BYTES=1048576
GATEWAY_MAX_BODY_BYTES=131072
GATEWAY_RATE_LIMIT_REQUESTS=60
GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60
# Used by Makefile/Compose, not read as application settings:
PORT=8000
GATEWAY_BIND_HOST=127.0.0.1
